{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/weather.js": { "maxDuration": 30 },
    "api/status.js":  { "maxDuration": 15 },
    "api/vessel.js":  { "maxDuration": 15 },
    "api/notify.js":  { "maxDuration": 15 },
    "api/cron.js":    { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}